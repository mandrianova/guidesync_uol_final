{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.guidesync.dev/release-task.schema.json",
  "title": "GuideSync Release Notes Task",
  "type": "object",
  "required": ["repositories", "period"],
  "properties": {
    "task_id": { "type": "string" },
    "created_at": { "type": "string" },
    "project": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "root": { "type": "string" },
        "env_file": { "type": "string" },
        "languages": {
          "type": "array",
          "description": "Languages required for localized outputs. English is always generated first; the rest are produced as translated release-notes.<lang>.html files.",
          "items": { "type": "string" }
        },
        "branding": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "logo_file": { "type": "string" },
            "css_file": { "type": "string" }
          },
          "additionalProperties": false
        },
        "copy": {
          "type": "object",
          "properties": {
            "catalog_file": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "audience": { "type": "string" },
        "language": {
          "type": "string",
          "description": "Optional guide language override, for example en or ru. If omitted, the agent detects the UI language."
        },
        "locale": {
          "type": "string",
          "description": "Optional guide locale override, for example en-US or ru-RU."
        },
        "languages": {
          "type": "array",
          "description": "Optional list of guide languages to generate.",
          "items": { "type": "string" }
        },
        "locales": {
          "type": "array",
          "description": "Optional list of guide locales to generate.",
          "items": { "type": "string" }
        },
        "example_context": {
          "type": "string",
          "description": "Optional product/domain context used when generating usage examples."
        }
      },
      "additionalProperties": false
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["path"],
            "properties": {
              "name": { "type": "string" },
              "path": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "period": {
      "type": "object",
      "required": ["since"],
      "properties": {
        "since": { "type": "string" },
        "until": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ref": { "type": "string" },
    "max_features": { "type": "integer", "minimum": 1 },
    "auth": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["none", "token_env", "browser_state"] },
        "env_file": { "type": "string" },
        "token_env": { "type": "string" },
        "state_path": { "type": "string" },
        "role": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "language": {
          "type": "string",
          "description": "Optional UI language hint, for example en or ru."
        },
        "locale": {
          "type": "string",
          "description": "Optional UI locale hint. If omitted, Playwright evidence is used when available."
        },
        "languages": {
          "type": "array",
          "description": "Optional list of UI languages to generate guides for.",
          "items": { "type": "string" }
        },
        "locales": {
          "type": "array",
          "description": "Optional list of UI locales to generate guides for.",
          "items": { "type": "string" }
        },
        "max_screenshots": { "type": "integer", "minimum": 1 },
        "wait_after_ms": { "type": "integer", "minimum": 0 },
        "expected_text": {
          "type": "array",
          "items": { "type": "string" }
        },
        "headed": { "type": "boolean" },
        "manual_auth": { "type": "boolean" },
        "auth": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["none", "token_env", "browser_state", "manual"] },
            "env_file": { "type": "string" },
            "token_env": { "type": "string" },
            "state_path": { "type": "string" }
          },
          "additionalProperties": false
        },
        "launch": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["none", "docker_compose", "docker_run", "command"]
            },
            "compose_file": { "type": "string" },
            "project_name": { "type": "string" },
            "service": { "type": "string" },
            "image": { "type": "string" },
            "name": { "type": "string" },
            "ports": {
              "type": "array",
              "items": { "type": "string" }
            },
            "volumes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "env_file": { "type": "string" },
            "env": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "args": {
              "type": "array",
              "items": { "type": "string" }
            },
            "command": {
              "type": "array",
              "items": { "type": "string" }
            },
            "wait_url": { "type": "string" },
            "timeout_seconds": { "type": "integer", "minimum": 1 },
            "down_after": { "type": "boolean" },
            "remove": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "route_overrides": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "capture_clips": {
          "type": "object",
          "description": "Optional per-feature screenshot clip overrides keyed by capture type, for example domains, chat or settings.",
          "additionalProperties": {
            "type": "object",
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "width": { "type": "number" },
              "height": { "type": "number" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "dir": { "type": "string" },
        "title": { "type": "string" },
        "language": {
          "type": "string",
          "description": "Optional output language override, for example en or ru."
        },
        "locale": {
          "type": "string",
          "description": "Optional output locale override, for example en-US or ru-RU."
        },
        "languages": {
          "type": "array",
          "description": "Optional list of output languages. The first one becomes release-notes.html; additional languages are written as release-notes.<lang>.html.",
          "items": { "type": "string" }
        },
        "locales": {
          "type": "array",
          "description": "Optional list of output locales. The first one becomes release-notes.html; additional languages are written as release-notes.<lang>.html.",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
