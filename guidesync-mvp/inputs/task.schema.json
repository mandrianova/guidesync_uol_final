{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.guidesync.dev/task.schema.json",
  "title": "GuideSync MVP Task",
  "type": "object",
  "required": [
    "task_id",
    "created_at",
    "trigger",
    "project_root",
    "repositories",
    "time_window",
    "ui",
    "documentation",
    "output"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Stable local identifier for this GuideSync run."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation time for the incoming task."
    },
    "trigger": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["manual", "branch_change", "pull_request", "scheduled", "message"]
        },
        "source": {
          "type": "string",
          "description": "Optional source such as CLI, CI, task manager, PR or chat message."
        },
        "message": {
          "type": "string",
          "description": "Optional natural-language instruction for the agent."
        }
      },
      "additionalProperties": false
    },
    "project_root": {
      "type": "string",
      "description": "Path to the product workspace."
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "path", "branch"],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "branch": {
            "type": "string",
            "description": "Branch/ref to inspect. Usually origin/main for diff discovery."
          },
          "role": {
            "type": "string",
            "enum": ["frontend", "backend", "agent_service", "artifact_service", "docs", "other"]
          }
        },
        "additionalProperties": false
      }
    },
    "time_window": {
      "type": "object",
      "required": ["since"],
      "properties": {
        "since": {
          "type": "string",
          "description": "Git-compatible time expression, for example '1 month ago'."
        },
        "until": {
          "type": "string",
          "description": "Optional Git-compatible end time."
        }
      },
      "additionalProperties": false
    },
    "diff_target": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "required": ["url", "repository", "start_command"],
      "properties": {
        "url": {
          "type": "string",
          "description": "Local or staging UI URL to open for screenshot capture."
        },
        "repository": {
          "type": "string"
        },
        "start_command": {
          "type": "string",
          "description": "Command to start the UI."
        },
        "working_directory": {
          "type": "string"
        },
        "auth": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["none", "manual", "token", "token_env", "username_password", "browser_state"]
            },
            "role": {
              "type": "string"
            },
            "state_path": {
              "type": "string"
            },
            "env_file": {
              "type": "string"
            },
            "token_env": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string"
        },
        "route_hint": {
          "type": "string"
        },
        "steps_hint": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_text": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Texts that should be present on the primary workflow page."
        },
        "capture_steps": {
          "type": "array",
          "description": "Reusable Playwright-compatible workflow steps. If omitted, guidesync-plan creates a minimal plan from url and route_hint.",
          "items": {
            "type": "object",
            "required": ["id", "action"],
            "properties": {
              "id": {
                "type": "string"
              },
              "action": {
                "type": "string",
                "enum": [
                  "navigate",
                  "click",
                  "fill",
                  "press",
                  "wait_for_text",
                  "wait_for_selector",
                  "wait_for_url",
                  "navigate_or_click",
                  "screenshot",
                  "scroll"
                ]
              },
              "target": {
                "type": "string"
              },
              "selector": {
                "type": "string"
              },
              "test_id": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "placeholder": {
                "type": "string"
              },
              "exact": {
                "type": "boolean"
              },
              "value": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "expected": {
                "type": "string"
              },
              "expected_text": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fail_on_missing_text": {
                "type": "boolean"
              },
              "screenshot": {
                "type": "string"
              },
              "capture": {
                "type": "object",
                "properties": {
                  "full_page": {
                    "type": "boolean"
                  },
                  "selector": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "delta_x": {
                "type": "number"
              },
              "delta_y": {
                "type": "number"
              },
              "wait_ms": {
                "type": "integer"
              },
              "wait_before_ms": {
                "type": "integer"
              },
              "wait_after_ms": {
                "type": "integer"
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "documentation": {
      "type": "object",
      "required": ["mode", "path"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["existing", "synthetic_stale_fixture"]
        },
        "path": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": ["markdown", "mdx", "html", "other"]
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["root"],
      "properties": {
        "root": {
          "type": "string"
        },
        "screenshots_dir": {
          "type": "string"
        },
        "report_path": {
          "type": "string"
        },
        "guide_update_path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
