{
  "protocol_version": "profile-knowledge-causal-v1",
  "prepared_before_outputs": true,
  "conditions": {
    "G": {"project_profile": true, "knowledge_base": true, "edit_planning": true},
    "G-P": {"project_profile": false, "knowledge_base": true, "edit_planning": true},
