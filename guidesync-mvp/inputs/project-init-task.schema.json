{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.guidesync.dev/project-init-task.schema.json",
  "title": "GuideSync Project Init Task",
  "type": "object",
  "required": ["task", "project"],
  "properties": {
    "task_id": { "type": "string" },
    "created_at": { "type": "string" },
    "task": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "const": "project_init" },
        "id": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": ["id", "name", "root"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "root": { "type": "string" },
        "env_file": { "type": "string" },
        "languages": {
          "type": "array",
          "description": "Languages required for localized outputs. English is always generated first; the rest are produced as translated release-notes.<lang>.html files.",
          "items": { "type": "string" }
        },
        "branding": {
          "type": "object",
          "description": "Optional overrides only. By default the init task discovers logo and colors from project.root.",
          "properties": {
            "name": { "type": "string" },
            "logo_file": { "type": "string" },
            "css_file": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "expected_text": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "project_dir": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
