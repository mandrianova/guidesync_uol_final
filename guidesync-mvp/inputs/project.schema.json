{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.guidesync.dev/project.schema.json",
  "title": "GuideSync Project",
  "type": "object",
  "required": ["project"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["id", "name", "root"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "root": { "type": "string" },
        "env_file": { "type": "string" }
      },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "properties": {
        "ref": { "type": "string" },
        "ui_url": { "type": "string" },
        "output_root": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
