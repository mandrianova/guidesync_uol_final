  "decision_rule": {
    "primary_signal": "On KB-dependent cases, G must select the correct document or cover a gold obligation that G-K misses without increasing unsupported claims on negative cases.",
    "not_sufficient": [
      "A wording-only difference",
      "A prepared context item that the model did not read",
      "A knowledge citation attached after generation",
      "A single unpaired successful run"
    ]
  },
  "cases": [
