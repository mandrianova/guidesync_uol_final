{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.guidesync.dev/project.schema.json",
  "title": "GuideSync Project",
  "type": "object",
  "required": ["project"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["id", "name", "root"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "root": { "type": "string" },
        "env_file": { "type": "string" },
        "languages": {
          "type": "array",
          "description": "Languages required for localized outputs. English is always generated first; the rest are produced as translated release-notes.<lang>.html files.",
          "items": { "type": "string" }
        },
        "branding": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "logo_file": { "type": "string" },
            "css_file": { "type": "string" }
          },
          "additionalProperties": false
        },
        "copy": {
          "type": "object",
          "properties": {
            "catalog_file": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "properties": {
        "ref": { "type": "string" },
        "ui_url": { "type": "string" },
        "output_root": { "type": "string" },
        "ui": {
          "type": "object",
          "properties": {
            "repository": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "required": ["path"],
                  "properties": {
                    "name": { "type": "string" },
                    "path": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "repositories": {
              "type": "array",
              "items": {
                "oneOf": [
                  { "type": "string" },
                  {
                    "type": "object",
                    "required": ["path"],
                    "properties": {
                      "name": { "type": "string" },
                      "path": { "type": "string" }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            "route_overrides": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
